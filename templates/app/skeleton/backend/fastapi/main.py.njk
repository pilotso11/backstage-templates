import os

from fastapi import FastAPI, Request
from fastapi.staticfiles import StaticFiles

from auth import AuthUser, get_auth_user

app = FastAPI(
    title="${{ values.name }} API",
    description="${{ values.description }}",
    version="1.0.0",
)


@app.get("/healthz", tags=["ops"])
async def health() -> dict[str, str]:
    """Health check endpoint."""
    return {"status": "ok"}


@app.get("/api/hello", tags=["example"])
async def hello() -> dict[str, str]:
    """Returns a hello message."""
    return {"message": "Hello from ${{ values.name }}!"}


@app.get("/api/whoami", tags=["auth"])
async def whoami(request: Request) -> AuthUser:
    """Get current authenticated user."""
    return get_auth_user(request)


# Serve frontend static files if STATIC_FILES_DIR is set
_static_dir = os.getenv("STATIC_FILES_DIR")
if _static_dir and os.path.isdir(_static_dir):
    app.mount("/", StaticFiles(directory=_static_dir, html=True), name="static")
