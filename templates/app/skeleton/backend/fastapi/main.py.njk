"""${{ values.name }} API — entry point."""

import logging
import os

from fastapi import FastAPI
from fastapi.staticfiles import StaticFiles

from app.handler import admin, auth, compute, features, health, todo
from app.model.db import build_dsn, get_engine, init_db

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

app = FastAPI(
    title="${{ values.name }} API",
    description="${{ values.description }}",
    version="1.0.0",
)

# ── Database (optional) ──────────────────────────────────────────────────────

_db_url = os.getenv("DATABASE_URL")
if _db_url:
    _dsn = build_dsn(_db_url, os.getenv("DB_USER", ""), os.getenv("DB_PASS", ""))
    try:
        init_db(_dsn)
        logger.info("Database connected")
    except Exception:
        logger.exception("WARNING: database connection failed")

# ── Routers ──────────────────────────────────────────────────────────────────

app.include_router(health.router)
app.include_router(auth.router)
app.include_router(compute.router)
app.include_router(admin.router)
app.include_router(features.router)

if get_engine() is not None:
    app.include_router(todo.router)
    logger.info("Todo routes enabled (database connected)")

# ── Static files ─────────────────────────────────────────────────────────────

_static_dir = os.getenv("STATIC_FILES_DIR")
if _static_dir and os.path.isdir(_static_dir):
    app.mount("/", StaticFiles(directory=_static_dir, html=True), name="static")
