func TestAdminUsers_DevUser_IsAuthorized(t *testing.T) {
	handler.ResetAuthorizedUsersForTest()

	tmpFile := "authorized_users.json"
	if err := os.WriteFile(tmpFile, []byte(`["dev@example.com"]`), 0644); err != nil {
		t.Fatalf("write temp file: %v", err)
	}
	defer func() { _ = os.Remove(tmpFile) }()

	t.Setenv("DEV_MODE", "true")
	t.Setenv("DEV_USER_EMAIL", "dev@example.com")

	_, body := doRequest(t, testAppWithDB(nil), "GET", "/api/admin/users")
	var resp handler.AdminUsersResponse
	if err := json.Unmarshal(body, &resp); err != nil {
		t.Fatalf("unmarshal JSON: %v", err)
	}
	if !resp.Authorized {
		t.Error("expected authorized=true for dev@example.com")
	}
}

