name: Docker Build & Push

on:
  push:
    branches: [main]
    tags: ["v*.*.*"]
  pull_request:
    branches: [main]

jobs:
  docker:
    name: Docker Build & Push
    runs-on: ubuntu-latest
    env:
      HAS_DOCKERHUB: {% raw %}${{ secrets.DOCKERHUB_USERNAME }}{% endraw %}
    steps:
      - uses: actions/checkout@v4

      - name: Docker meta
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ values.dockerhub_org }}/${{ values.name }}
          tags: |
            type=ref,event=branch
            type=ref,event=pr
            type=semver,pattern={% raw %}{{version}}{% endraw %}
            type=semver,pattern={% raw %}{{major}}.{{minor}}{% endraw %}
            type=semver,pattern={% raw %}{{major}}{% endraw %}
            type=sha
            type=raw,value=latest,enable={% raw %}${{ github.ref == format('refs/heads/{0}', github.event.repository.default_branch) || startsWith(github.ref, 'refs/tags/v') }}{% endraw %}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to Docker Hub
        if: {% raw %}${{ github.event_name != 'pull_request' && env.HAS_DOCKERHUB != '' }}{% endraw %}
        uses: docker/login-action@v3
        with:
          username: {% raw %}${{ secrets.DOCKERHUB_USERNAME }}{% endraw %}
          password: {% raw %}${{ secrets.DOCKERHUB_TOKEN }}{% endraw %}

      - name: Build and push
        uses: docker/build-push-action@v6
        with:
          context: .
          platforms: linux/amd64
          push: {% raw %}${{ github.event_name != 'pull_request' && env.HAS_DOCKERHUB != '' }}{% endraw %}
          tags: {% raw %}${{ steps.meta.outputs.tags }}{% endraw %}
          labels: {% raw %}${{ steps.meta.outputs.labels }}{% endraw %}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  notify:
    name: Trigger Flux Deploy
    needs: [docker]
    if: {% raw %}${{ github.event_name != 'pull_request' && secrets.DOCKERHUB_USERNAME != '' }}{% endraw %}
    runs-on: ubuntu-latest
    steps:
      - name: Trigger Flux reconciliation
        env:
          WEBHOOK_URL: {% raw %}${{ secrets.FLUX_WEBHOOK_URL }}{% endraw %}
          WEBHOOK_TOKEN: {% raw %}${{ secrets.FLUX_WEBHOOK_TOKEN }}{% endraw %}
        run: |
          if [ -n "$WEBHOOK_URL" ] && [ -n "$WEBHOOK_TOKEN" ]; then
            BODY='{}'
            SIG=$(echo -n "$BODY" | openssl dgst -sha256 -hmac "$WEBHOOK_TOKEN" | awk '{print $2}')
            curl -s -X POST "$WEBHOOK_URL" \
              -H "Content-Type: application/json" \
              -H "X-Hub-Signature-256: sha256=$SIG" \
              -d "$BODY"
            echo "Flux webhook triggered"
          else
            echo "Flux webhook secrets not configured, skipping"
          fi
