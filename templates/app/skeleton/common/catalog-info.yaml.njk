apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: ${{ values.name }}
  description: ${{ values.description }}
  annotations:
    github.com/project-slug: ${{ values.owner }}/${{ values.name }}
    backstage.io/kubernetes-id: ${{ values.name }}
  links:
    - url: https://${{ values.name }}.staging.oshers.com
      title: Live Site
      icon: web
    - url: https://github.com/${{ values.owner }}/${{ values.name }}/actions
      title: CI/CD Pipelines
      icon: github
    - url: https://hub.docker.com/r/${{ values.dockerhub_org }}/${{ values.name }}
      title: Docker Hub
      icon: docker
    - url: https://vscode.dev/redirect?url=vscode://ms-vscode-remote.remote-containers/cloneInVolume?url=https://github.com/${{ values.owner }}/${{ values.name }}
      title: Open in Dev Container
      icon: code
spec:
  type: service
  lifecycle: experimental
  owner: user:default/${{ values.backstageUser }}
{% if values.backend !== "none" %}  providesApis:
    - ${{ values.name }}-api
{% endif %}{% if values.enableDatabase %}  dependsOn:
    - resource:default/${{ values.name }}-db
{% endif %}
---
{% if values.backend !== "none" %}apiVersion: backstage.io/v1alpha1
kind: API
metadata:
  name: ${{ values.name }}-api
  description: REST API for ${{ values.name }}
  annotations:
    github.com/project-slug: ${{ values.owner }}/${{ values.name }}
    backstage.io/kubernetes-id: ${{ values.name }}
  tags:
    - api
    - rest
{% if values.backend == "fastapi" %}    - python
    - fastapi
{% elif values.backend == "gofiber" %}    - go
    - fiber
{% endif %}
spec:
  type: openapi
  lifecycle: experimental
  owner: user:default/${{ values.backstageUser }}
{% if values.backend == "fastapi" %}  definition:
    $text: http://${{ values.name }}.${{ values.name }}.svc.cluster.local:8000/openapi.json
{% elif values.backend == "gofiber" %}  definition:
    $text: http://${{ values.name }}.${{ values.name }}.svc.cluster.local:8000/swagger/doc.json
{% endif %}
{% endif %}{% if values.enableDatabase %}---
apiVersion: backstage.io/v1alpha1
kind: Resource
metadata:
  name: ${{ values.name }}-db
  description: PostgreSQL database for ${{ values.name }}, managed by CloudNativePG
  annotations:
    backstage.io/kubernetes-id: ${{ values.name }}
  tags:
    - database
    - postgresql
    - cloudnative-pg
  links:
    - url: https://cloudnative-pg.io/
      title: CloudNativePG Documentation
spec:
  type: database.cloudnative-pg
  lifecycle: experimental
  owner: user:default/${{ values.backstageUser }}
{% endif %}